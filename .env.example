# Copia este archivo como .env y completa tus datos.
#
# 1. Crea una cuenta gratuita en https://www.themoviedb.org/
# 2. Ve a Configuración > API y solicita una clave (uso personal/educativo).
# 3. Pega aquí tu clave. El archivo .env NO se sube a GitHub (está en .gitignore).

# Opción A: clave v3 (la más común)
TMDB_API_KEY=

# Opción B (recomendada): token de lectura v4.
# Si lo usas, puedes dejar TMDB_API_KEY vacío.
TMDB_READ_TOKEN=

# Puerto del servidor local (opcional)
PORT=3000

# Idioma de los datos que devuelve TMDB (opcional)
TMDB_LANGUAGE=es-ES
